# Password that gates the whole site (leave unset to run open on localhost)
APP_PASSWORD=
# Anthropic key for the tutor and the content pipeline
ANTHROPIC_API_KEY=
# Tyndale NLT API key (optional; without it the anonymous limit of 500 requests a day applies)
NLT_API_KEY=
# Supabase, for syncing notes and decks across devices (optional; without it state stays in the browser)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
