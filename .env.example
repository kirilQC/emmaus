# OpenAI key for the tutor and the content pipeline
OPENAI_API_KEY=
# Model to use (default gpt-5)
OPENAI_MODEL=gpt-5
# Tyndale NLT API key (optional; without it the anonymous limit of 500 requests a day applies)
NLT_API_KEY=
# Supabase, for syncing notes and decks across devices (optional; without it state stays in the browser)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Reasoning effort for the tutor: low (default, about 14s an answer), medium or high
OPENAI_REASONING=low
# The tutor's voice. Optional. Set this in Vercel to change how the tutor answers without a deploy.
# It replaces the default voice; the tool, citation and link rules are always appended after it.
# Print the current one with: node scripts/tutor-prompt.mjs
TUTOR_SYSTEM_PROMPT=
# Optional: added to the end of whichever voice is in use, for a small tweak without restating the whole thing.
TUTOR_PROMPT_APPEND=
